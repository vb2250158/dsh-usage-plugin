{
  "name": "dsh-usage-plugin",
  "version": "1.23.3",
  "description": "DeepSeek Harness usage & cost tracker plugin, forked to price any model via the OpenRouter catalog: per-call token/cache-hit stats, cache-aware cost, CSV/JSON/PNG export with custom destination, and persistent local storage. Ships a host half plus a web client half in one npm package; installs into a DSH profile as a dsh.bundle with one command (dsh plugin --profile web add github:vb2250158/dsh-usage-plugin#<sha>).",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "usage",
    "cost",
    "tokens",
    "cache",
    "openrouter"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-usage-plugin.git"
  },
  "contributors": [
    {
      "name": "ayleen",
      "url": "https://github.com/ayleen"
    },
    {
      "name": "wuhuqif176",
      "url": "https://github.com/wuhuqif176"
    },
    {
      "name": "Martin-soaring-dev",
      "url": "https://github.com/Martin-soaring-dev"
    },
    {
      "name": "liu3734",
      "url": "https://github.com/liu3734"
    },
    {
      "name": "mumuer1024",
      "url": "https://github.com/mumuer1024"
    }
  ],
  "homepage": "https://github.com/vb2250158/dsh-usage-plugin#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-usage-plugin/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./usage-statistics-slots": {
      "types": "./lib/usage-statistics-slots.d.ts"
    },
    "./pricing": "./lib/pricing.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "upstreamRepository": "feiyang-dev/dsh-usage-plugin",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "files": [
    "lib",
    "scripts",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt"
  ],
  "scripts": {
    "test": "node --test",
    "wire": "node scripts/wire.js",
    "check": "node scripts/check-package.js",
    "prepublishOnly": "node scripts/check-package.js",
    "pack": "npm pack"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-primitives": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-workspace": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/cordis": ">=4.0.5-alpha.1 <5.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0"
  },
  "dependencies": {
    "undici": "^7.0.0"
  },
  "icon": "./icon.svg"
}
